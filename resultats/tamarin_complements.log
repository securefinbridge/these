   Out( <senc(<h(<'sid', k>), c, ~montant, $benef>, k), 
         mac(h(<h(<'sid', k>), c, ~montant, $benef>), k)>
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) R_Recoit_Instruction:
