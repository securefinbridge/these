rule (modulo E) Session:
   [ Fr( ~k ) ]
  --[ Session( ~k ) ]->
   [ Etat_I_2( ~k, 'zero' ), Etat_R_2( ~k, 'zero' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) I_Emet_Instruction:
   [ Etat_I_2( k, c ), Fr( ~montant ) ]
