    (InstructionEmise( sid, c, m ) @ #i) ∧
    (InstructionRecue( sid, c, m ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ sid c m #i #j.
  (InstructionEmise( sid, c, m ) @ #i) ∧
  (InstructionRecue( sid, c, m ) @ #j)"
*/
simplify
solve( !KU( senc(<h(<'sid', k>), c, ~montant, benef.1>, k) ) @ #vk.1 )
  case I_Emet_Instruction_case_1
  solve( Etat_I_2( k, c ) ▶₀ #i )
    case Session
    solve( Etat_R_2( ~k, 'zero' ) ▶₀ #j )
      case Session
      solve( !KU( mac(h(<h(<'sid', ~k>), 'zero', ~montant, $benef>), ~k)
             ) @ #vk.2 )
        case I_Emet_Instruction_case_2
        SOLVED // trace found
      qed
    qed
  qed
qed

