lemma P4_non_rejeu:
  all-traces
  "∀ sid c m #i #j.
    ((InstructionRecue( sid, c, m ) @ #i) ∧
     (InstructionRecue( sid, c, m ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ sid c m #i #j.
  (InstructionRecue( sid, c, m ) @ #i) ∧
  (InstructionRecue( sid, c, m ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
by contradiction /* from formulas */

