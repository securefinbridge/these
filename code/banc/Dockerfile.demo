# Image du démonstrateur SecureFinBridge (console HTTP + passerelle SFB-AKA + bouchon ISO 20022).
#
#   docker build -f banc/Dockerfile.demo -t sfb-demo .        (contexte : le dossier code/)
#   docker run --rm -p 8080:8080 sfb-demo
#
# Prototype de démonstration. Aucune clé n'est cuite dans l'image : le lanceur génère les clés
# de démonstration au démarrage, dans /donnees (un volume jetable en production).
# Pas de tc netem ici : ni iproute2 ni capacité NET_ADMIN, contrairement à l'image du banc.

# ---- construction -----------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-21 AS construction
WORKDIR /src
COPY banc/pom.xml ./
RUN mvn -q -B dependency:go-offline
COPY banc/src ./src
COPY banc/ressources ./ressources
RUN mvn -q -B package -DskipTests \
 && cp target/passerelle-demo-*.jar /app.jar

# ---- exécution ----------------------------------------------------------------------
# Le JDK et non le JRE : le lanceur appelle keytool pour la PKI de la référence TLS 1.3.
FROM eclipse-temurin:21-jdk
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 sfb \
 && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin sfb \
 && mkdir -p /app /donnees \
 && chown 10001:10001 /donnees
WORKDIR /app
# Le lanceur cherche politique.properties et bouchon_cbs.py dans le dossier courant.
# Droits fixés ici : ils ne dépendent pas de ceux des fichiers sur le poste qui construit l'image.
COPY --chmod=0444 --from=construction /app.jar ./app.jar
COPY --chmod=0444 bouchon_cbs.py banc/politique.properties ./
ARG COMMIT=local
ENV LANG=C.UTF-8 \
    SFB_COMMIT=$COMMIT \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=40 -XX:+ExitOnOutOfMemoryError"
USER 10001:10001
EXPOSE 8080
# Le lanceur démarre le bouchon et la passerelle, puis /sante surveille les deux processus.
ENTRYPOINT ["java", "-jar", "app.jar", "--sfb.dossier=/donnees"]
